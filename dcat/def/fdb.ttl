    rdfs:range xsd:string ;
    fdb:origin "upstream" ;
.

fdb:programmeSlug
    a rdf:Property ;
    rdfs:label "programme_slug" ;
    rdfs:comment "last path segment of the source URL. Not unique -- a programme offered by several Länder appears once per Land with the same slug -- so it does not identify a row; id_url does"@en ;
    rdfs:domain fdb:Foerderprogramm ;
    rdfs:isDefinedBy <https://fdb.cdl.correlaid.org/def/fdb> ;
    rdfs:range xsd:string ;
    fdb:origin "upstream" ;
.

