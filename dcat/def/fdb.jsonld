        "@id": "https://fdb.cdl.correlaid.org/def/fdb"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "on_website_from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://fdb.cdl.correlaid.org/def/fdb#origin": [
      {
        "@value": "derived"
      }
    ]
  },
  {
    "@id": "https://fdb.cdl.correlaid.org/def/fdb#onWebsiteTo",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "last ISO week in which this programme was still present in the export. Null for programmes still present. Observed by comparing loads, so the disappearance falls between this week and the next load. For absent programmes this may be much later than the last content change (last_updated)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb#Foerderprogramm"
      }
