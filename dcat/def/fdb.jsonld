      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://fdb.cdl.correlaid.org/def/fdb#origin": [
      {
        "@value": "derived"
      }
    ]
  },
  {
    "@id": "https://fdb.cdl.correlaid.org/def/fdb#origin",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Where a column's values come from: \"upstream\" -- stated by the source export and only reshaped; \"derived\" -- computed from upstream values or from the load history by a rule, exactly and reproducibly; \"inferred\" -- produced by a machine-learning model, therefore neither deterministic nor exact. The inferred columns are keywords_extracted; their accuracy is measured against a labelled sample rather than guaranteed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "origin"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://fdb.cdl.correlaid.org/def/fdb#previousUpdateDates",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "one ISO week per observed content change, ascending. Empty for a programme that has never changed. Its length is the number of weeks in which a change was seen, not the number of changes: a week is a single comparison between two loads, so two changes within one week are indistinguishable from one. For absent programmes, excludes the final transition (the absence), containing only actual content changes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb#Foerderprogramm"
      }
